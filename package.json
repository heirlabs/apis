{
  "name": "@heirlabs/api",
  "version": "1.0.0",
  "description": "Public docs and integrator reference for the HEIR HTTP API",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node serve-docs.mjs",
    "dev": "npm run docs:dev",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:serve": "node serve-docs.mjs",
    "openapi:fetch": "node scripts/fetch-openapi.mjs",
    "test": "node scripts/validate-docs-truth.mjs",
    "test:docs-truth": "node scripts/validate-docs-truth.mjs",
    "examples:health": "bash examples/01-health.sh",
    "examples:plans": "bash examples/04-list-plans.sh"
  },
  "keywords": [
    "heir",
    "inheritance",
    "estate-planning",
    "smart-contracts",
    "api",
    "openapi",
    "documentation",
    "webhooks",
    "mcp",
    "ethereum",
    "solana"
  ],
  "author": "HEIR Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heirlabs/apis.git"
  },
  "homepage": "https://docs.heir.es",
  "bugs": {
    "url": "https://github.com/heirlabs/apis/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "vitepress": "^1.0.0"
  }
}
